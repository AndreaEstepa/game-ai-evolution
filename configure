#!/bin/sh

if [ ! -f "./.steamuid" ]; then
    printf 'error: no Steam user ID file found\n' >&2
    exit 1
fi

IFS= read -r STEAM_USER_ID < "./.steamuid"

SILKSONG_CONFIG_DIR="${HOME}/.config/unity3d/Team Cherry/Hollow Knight Silksong/${STEAM_USER_ID}"

mkdir -p "${SILKSONG_CONFIG_DIR}"
cp -r -t "${SILKSONG_CONFIG_DIR}" \
    "./resources/silksong/profile_id/Modded" \
    "./resources/silksong/profile_id/user2.dat"
